{
  "name": "KIRAKA — Find help. Discover opportunity.",
  "short_name": "KIRAKA",
  "description": "A Rwanda-first local services and opportunities marketplace.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#205641",
