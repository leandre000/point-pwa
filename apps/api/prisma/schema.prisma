// ─── KIRAKA Database Schema (Prisma) ───
// PostgreSQL with strict constraints, minor units for money, country/locale from day one.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
  SUPPORT
}

enum VerificationLevel {
  NONE
  PHONE_VERIFIED
  IDENTITY_CHECKED
  BUSINESS_CHECKED
  QUALIFICATION_VERIFIED
}

enum JobStatus {
  DRAFT
  OPEN
  MATCHED
  IN_PROGRESS
  COMPLETION_REPORTED
  COMPLETED
  CANCELLED
  EXPIRED
  CLOSED
  DISPUTED
}

enum OfferStatus {
  SUBMITTED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum MatchStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

enum UserStatus {
  PENDING_VERIFICATION
  PENDING_PASSWORD
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationPurpose {
  SIGNUP_VERIFY
  PASSWORD_RESET
}

// ─── Users & Sessions (D-017, D-018) ───

model User {
  id              String            @id @default(uuid()) @db.Uuid
  email           String            @unique
  emailVerifiedAt DateTime?
  passwordHash    String?           // Argon2id hash, nullable for Google-only accounts
  googleSub       String?           @unique
  fullName        String            @default("") @db.VarChar(100)
  phone           String?           // Optional, private field in personal details
  status          UserStatus        @default(PENDING_VERIFICATION)
  role            UserRole          @default(USER)
  countryCode     String            @default("RW") @db.VarChar(2)
  locale          String            @default("en") @db.VarChar(5)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  customerProfile   CustomerProfile?
  providerProfile   ProviderProfile?
  sessions          UserSession[]
  verificationCodes VerificationCode[]
  jobs              Job[]             @relation("CustomerJobs")
  offers            Offer[]           @relation("ProviderOffers")
  messages          Message[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  raisedDisputes    Dispute[]         @relation("RaisedDisputes")
  authoredReviews   Review[]          @relation("AuthoredReviews")
  receivedReviews   Review[]          @relation("ReceivedReviews")
  filedReports      UserReport[]      @relation("FiledReports")
  receivedReports   UserReport[]      @relation("ReceivedReports")
  blocksInitiated   UserBlock[]       @relation("UserBlocksInitiated")
  blocksReceived    UserBlock[]       @relation("UserBlocksReceived")

  @@index([email])
  @@index([googleSub])
  @@index([countryCode])
}

model UserSession {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  token              String    @unique
  refreshToken       String?   @unique
  rotatedToken       String?   // Previous refresh token allowed during grace period
  rotatedAt          DateTime? // Timestamp when token was rotated (10s grace window)
  deviceLabel        String?
  userAgent          String?
  ipAddress          String?
  lastUsedAt         DateTime  @default(now())
  revokedAt          DateTime?
  expiresAt          DateTime
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([refreshToken])
}

// ─── Admin Identity & Sessions (D-024) ───

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
  MODERATOR
}

model AdminAccount {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique
  fullName          String             @db.VarChar(100)
  passwordHash      String
  role              AdminRole          @default(SUPER_ADMIN)
  twoFactorEnabled  Boolean            @default(false)
  twoFactorSecret   String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  sessions          AdminSession[]
  handoffCodes      AdminHandoffCode[]

  @@index([email])
}

model AdminSession {
  id           String       @id @default(uuid()) @db.Uuid
  adminId      String       @db.Uuid
  token        String       @unique
  userAgent    String?
  ipAddress    String?
  lastUsedAt   DateTime     @default(now())
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime     @default(now())

  admin        AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([token])
}

model AdminHandoffCode {
  id            String       @id @default(uuid()) @db.Uuid
  adminId       String       @db.Uuid
  codeHash      String       @unique
  ipHash        String
  userAgentHash String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime     @default(now())

  admin         AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([codeHash])
  @@index([adminId])
}

model VerificationCode {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String?             @db.Uuid
  email      String
  purpose    VerificationPurpose
  codeHash   String              // HMAC-SHA256 with salt
  salt       String
  expiresAt  DateTime
  attempts   Int                 @default(0)
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
}

// ─── Profiles ───

model CustomerProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  displayName  String   @db.VarChar(100)
  neighborhood String?  @db.VarChar(100)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderProfile {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @unique @db.Uuid
  businessName      String            @db.VarChar(100)
  bio               String?           @db.VarChar(1000)
  verificationLevel VerificationLevel @default(NONE)
  isVisible         Boolean           @default(true)
  completedJobs     Int               @default(0)
  ratingAverage     Int?              // Scale 100-500 (e.g., 480 = 4.8)
  ratingCount       Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Marketplace Core ───

model ServiceCategory {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  nameEn       String
  nameRw       String
  nameFr       String
  description  String?  @db.VarChar(500)
  iconName     String   @default("Sparkles")
  coverPhotoUrl String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobs Job[]
}

model ServiceArea {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  city        String   @default("Kigali")
  countryCode String   @default("RW") @db.VarChar(2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs Job[]
}

model Job {
  id               String      @id @default(uuid()) @db.Uuid
  customerId       String      @db.Uuid
  categoryId       String      @db.Uuid
  areaId           String      @db.Uuid
  title            String      @db.VarChar(200)
  description      String      @db.VarChar(2000)
  status           JobStatus   @default(OPEN)
  addressNotes     String?     @db.VarChar(200)
  
  // Money stored strictly as integer minor units (RWF has 0 decimal digits, minor unit = franc)
  budgetAmount     BigInt?
  budgetCurrency   String      @default("RWF") @db.VarChar(3)
  budgetNegotiable Boolean     @default(true)

  timingPreference String?     @db.VarChar(200)
  startsAt         DateTime?
  windowType       String?     @default("asap")
  timezone         String?     @default("Africa/Kigali")
  expiresAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer User            @relation("CustomerJobs", fields: [customerId], references: [id], onDelete: Restrict)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  area     ServiceArea     @relation(fields: [areaId], references: [id], onDelete: Restrict)
  offers   Offer[]
  attachments JobAttachment[]
  match    Match?

  @@index([customerId])
  @@index([categoryId])
  @@index([areaId])
  @@index([status])
}

model JobAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @db.Uuid
  url       String
  caption   String?  @db.VarChar(200)
  sizeBytes Int?
  mimeType  String   @db.VarChar(50)
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Offer {
  id           String      @id @default(uuid()) @db.Uuid
  jobId        String      @db.Uuid
  providerId   String      @db.Uuid
  status       OfferStatus @default(SUBMITTED)
  
  // Minor units
  priceAmount  BigInt
  priceCurrency String     @default("RWF") @db.VarChar(3)

  message      String?     @db.VarChar(1000)
  availability String?     @db.VarChar(200)
  version      Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider User     @relation("ProviderOffers", fields: [providerId], references: [id], onDelete: Restrict)
  matches  Match[]
  versions OfferVersion[]

  @@unique([jobId, providerId])
  @@index([jobId])
  @@index([providerId])
}

model OfferVersion {
  id          String   @id @default(uuid()) @db.Uuid
  offerId     String   @db.Uuid
  authorRole  String   @db.VarChar(20) // "PROVIDER" or "CUSTOMER"
  priceAmount BigInt
  message     String?  @db.VarChar(1000)
  createdAt   DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
}

model Match {
  id            String      @id @default(uuid()) @db.Uuid
  jobId         String      @unique @db.Uuid
  offerId       String      @db.Uuid
  status        MatchStatus @default(ACTIVE)

  // Snapshotted agreed terms at accept time
  agreedPriceAmount   BigInt
  agreedPriceCurrency String   @default("RWF") @db.VarChar(3)
  agreedTerms         String?

  acceptedAt    DateTime    @default(now())
  completedAt   DateTime?
  cancelledAt   DateTime?
  completionNotes String?   @db.VarChar(1000)
  completionPhotoUrl String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Restrict)
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  conversation Conversation?
  dispute      Dispute?
  reviews      Review[]

  @@index([jobId])
  @@index([offerId])
  @@index([status])
}

// ─── Messaging & Notifications ───

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  matchId   String    @unique @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  match    Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([matchId])
}

enum MessageType {
  TEXT
  ADDRESS_SHARE
  SYSTEM
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  senderId       String      @db.Uuid
  content        String      @db.VarChar(2000)
  type           MessageType @default(TEXT)
  readAt         DateTime?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId])
  @@index([senderId])
}

enum NotificationType {
  NEW_OFFER
  COUNTER_OFFER
  OFFER_ACCEPTED
  OFFER_REJECTED
  OFFER_WITHDRAWN
  MATCH_CREATED
  MATCH_CANCELLED
  NEW_MESSAGE
  COMPLETION_REPORTED
  COMPLETION_CONFIRMED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  NEW_REVIEW
  REMINDER
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  type       NotificationType
  title      String           @db.VarChar(100)
  body       String           @db.VarChar(500)
  entityType String?          @db.VarChar(50)
  entityId   String?          @db.VarChar(100)
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ─── Auditing ───

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   String   @db.VarChar(100)
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// ─── Disputes & Reviews (M6) ───

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum DisputeReason {
  POOR_QUALITY
  INCOMPLETE_WORK
  NO_SHOW
  PAYMENT_DISPUTE
  PROPERTY_DAMAGE
  UNPROFESSIONAL_BEHAVIOR
  OTHER
}

model Dispute {
  id           String        @id @default(uuid()) @db.Uuid
  matchId      String        @unique @db.Uuid
  raisedById   String        @db.Uuid
  reason       DisputeReason
  description  String        @db.VarChar(2000)
  evidenceUrls String[]      @default([])
  status       DisputeStatus @default(OPEN)
  resolution   String?       @db.VarChar(2000)
  resolvedAt   DateTime?
  resolvedById String?       @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  match    Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  raisedBy User  @relation("RaisedDisputes", fields: [raisedById], references: [id], onDelete: Restrict)

  @@index([matchId])
  @@index([status])
  @@index([raisedById])
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @db.Uuid
  authorId  String   @db.Uuid
  targetId  String   @db.Uuid
  rating    Int      // 1 to 5
  tags      String[] @default([])
  comment   String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  author User  @relation("AuthoredReviews", fields: [authorId], references: [id], onDelete: Restrict)
  target User  @relation("ReceivedReviews", fields: [targetId], references: [id], onDelete: Restrict)

  @@unique([matchId, authorId])
  @@index([targetId])
  @@index([matchId])
}

// ─── Safety, Reports & Blocks (M7) ───

enum ReportReason {
  SPAM
  INAPPROPRIATE_CONTENT
  HARASSMENT
  FRAUD
  SAFETY_CONCERN
  FAKE_PROFILE
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

model UserReport {
  id           String       @id @default(uuid()) @db.Uuid
  reporterId   String       @db.Uuid
  targetUserId String?      @db.Uuid
  targetJobId  String?      @db.Uuid
  reason       ReportReason
  details      String       @db.VarChar(2000)
  status       ReportStatus @default(PENDING)
  notes        String?      @db.VarChar(2000)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reporter   User  @relation("FiledReports", fields: [reporterId], references: [id], onDelete: Restrict)
  targetUser User? @relation("ReceivedReports", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([targetUserId])
  @@index([status])
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  reason    String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}


